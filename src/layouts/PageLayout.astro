---
/** Simple text page: about, contact, privacy, etc. */
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  description: string;
  /** No longer shown: headings carry their own weight. */
  eyebrow?: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article>
    <header class="band">
      <div class="container">
        <h1>{title}</h1>
      </div>
    </header>
    <div class="container page-body">
      <div class="sheet">
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page-body {
    padding-bottom: clamp(48px, 8vw, 88px);
  }
  /* Title lines up with the paper sheet below it. */
  .band h1 {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: clamp(4px, 1vw, 8px);
  }
</style>
