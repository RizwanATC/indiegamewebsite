---
/** Simple text page: about, contact, privacy, etc. */
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  description: string;
  /** No longer shown: headings carry their own weight. */
  eyebrow?: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="section">
    <div class="container">
      <h1>{title}</h1>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
