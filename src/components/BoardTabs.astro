---
/**
 * The home page leaderboard: a tab per game and that game's arcade board
 * (podium + rows, from Leaderboard.astro). Every board is rendered and loads
 * its own scores; the tabs only show one at a time.
 */
import Leaderboard from './Leaderboard.astro';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
import { LEADERBOARDS } from '../config';

interface Props {
  games: { slug: string; title: string; href: string; cover?: ImageMetadata }[];
  /** The tab that starts open (today's game when it has a board). */
  initial?: string;
}
const { games, initial } = Astro.props;
const list = games.filter((g) => LEADERBOARDS[g.slug]);
const first = list.find((g) => g.slug === initial)?.slug ?? list[0]?.slug;
---

{
  list.length > 0 && (
    <div class="board-tabs" data-board-tabs>
      <div class="head">
        <div class="tabs" role="tablist" aria-label="Leaderboard: pick a game">
          {list.map((g) => (
            <button
              type="button"
              role="tab"
              class="tab"
              id={`bt-tab-${g.slug}`}
              aria-controls={`bt-panel-${g.slug}`}
              aria-selected={g.slug === first ? 'true' : 'false'}
              tabindex={g.slug === first ? 0 : -1}
              data-tab={g.slug}
            >
              {g.title}
            </button>
          ))}
        </div>
      </div>
      {list.map((g) => (
        <div id={`bt-panel-${g.slug}`} role="tabpanel" aria-labelledby={`bt-tab-${g.slug}`} data-tab-panel={g.slug} hidden={g.slug !== first}>
          <Leaderboard game={g.slug} title={g.title} href={g.href} cover={g.cover} headingLevel={3} limit={5} />
        </div>
      ))}
      <a class="all" href="/leaderboard/">
        Full leaderboard <Icon name="arrow" />
      </a>
    </div>
  )
}

<style>
  .board-tabs {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tab {
    padding: 6px 11px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab[aria-selected='true'] {
    border-color: #f7c948;
    background: #f7c948;
    color: #1b1538;
  }
  .all {
    justify-self: end;
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-board-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-tab-panel]')];
    function select(tab: HTMLButtonElement, focus = false) {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      }
      for (const p of panels) p.hidden = p.dataset.tabPanel !== tab.dataset.tab;
      if (focus) tab.focus();
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(tabs[(i + d + tabs.length) % tabs.length], true);
      });
    });
  });
</script>
