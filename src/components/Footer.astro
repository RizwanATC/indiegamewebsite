---
import Logo from './Logo.astro';
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="slot" aria-hidden="true"><span></span></div>
  <div class="container inner">
    <div class="brand">
      <Logo />
      <p class="muted">{SITE.tagline}. A small, independent showcase for games made by small, independent teams.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/games/">All games</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/report/">Report a Game</a></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>© {year} {SITE.name}. Game names, artwork and trademarks belong to their respective developers.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(48px, 8vw, 96px);
    background: var(--ink);
    color: #dfe4f3;
  }
  .slot {
    display: grid;
    place-items: center;
    padding-top: 28px;
  }
  .slot span {
    width: 64px;
    height: 12px;
    border-radius: var(--radius-pill);
    background: #0c0f22;
    box-shadow:
      0 0 0 4px #2b3157,
      0 1px 0 4px rgb(255 255 255 / 0.12);
  }
  .inner {
    display: grid;
    gap: 24px;
    padding-block: 28px 28px;
  }
  .brand p {
    margin: 16px 0 0;
    max-width: 44ch;
    font-size: 0.95rem;
    color: #c3c9de;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    display: inline-block;
    padding: 8px 0;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }
  ul a:hover {
    color: var(--sun);
    text-decoration: underline;
  }
  .legal {
    padding-block: 18px 36px;
    border-top: 1px solid #2f3660;
    font-size: 0.82rem;
    color: #aeb5cf;
  }
  .legal p {
    margin: 0;
  }
  @media (min-width: 760px) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
</style>
