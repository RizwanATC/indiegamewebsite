---
/**
 * Asks a new visitor for a player name for the leaderboards. Shown once per
 * browser session until they pick one; "Maybe later" closes it. Any element
 * with [data-name-open] reopens it (the name chip in the header does).
 */
import { NAME_MAX } from '../lib/player';
---

<dialog class="name-dialog" data-name-dialog aria-labelledby="name-title">
  <form method="dialog" data-name-form>
    <p class="eyebrow">Player 1</p>
    <h2 id="name-title">What should we call you?</h2>
    <p class="muted">Your name goes on the leaderboard of every game you play here. You can change it any time.</p>
    <label for="player-name" class="visually-hidden">Player name</label>
    <input
      id="player-name"
      class="input"
      name="name"
      type="text"
      required
      minlength="2"
      maxlength={NAME_MAX}
      autocomplete="nickname"
      autocapitalize="words"
      spellcheck="false"
      placeholder="Your name"
      data-name-input
    />
    <p class="error" data-name-error hidden>Use 2 to {NAME_MAX} letters or numbers.</p>
    <div class="actions">
      <button type="submit" class="btn btn-primary" value="save">Save name</button>
      <button type="button" class="btn btn-ghost" data-name-later>Maybe later</button>
    </div>
  </form>
</dialog>

<style>
  .name-dialog {
    width: min(420px, calc(100vw - 32px));
    padding: 24px;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: 8px 8px 0 0 #2e1065;
  }
  .name-dialog::backdrop {
    background: rgb(6 5 12 / 0.75);
    backdrop-filter: blur(3px);
  }
  h2 {
    font-size: 1.25rem;
    margin: 0 0 8px;
  }
  .muted {
    margin: 0 0 16px;
    font-size: 0.925rem;
  }
  .error {
    margin: 8px 0 0;
    color: var(--danger);
    font-size: 0.875rem;
  }
  .error[hidden] {
    display: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
</style>

<script>
  import { cleanName, getPlayer, setName } from '../lib/player';

  const SKIP = 'indie24.namePromptSkipped';
  const dialog = document.querySelector<HTMLDialogElement>('[data-name-dialog]')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-name-form]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-name-input]')!;
  const error = dialog.querySelector<HTMLElement>('[data-name-error]')!;

  function open() {
    input.value = getPlayer().name;
    error.hidden = true;
    if (!dialog.open) dialog.showModal();
    input.focus();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = cleanName(input.value);
    if (!name) {
      error.hidden = false;
      input.focus();
      return;
    }
    setName(name);
    dialog.close();
  });
  // "Later" means later: don't ask again for a week (not just this tab).
  const skip = () => {
    try {
      localStorage.setItem(SKIP, String(Date.now()));
    } catch {}
  };
  dialog.querySelector('[data-name-later]')!.addEventListener('click', () => {
    skip();
    dialog.close();
  });
  dialog.addEventListener('cancel', skip);

  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest?.('[data-name-open]')) open();
  });

  const WEEK = 7 * 24 * 60 * 60 * 1000;
  let skipped = false;
  try {
    skipped = Date.now() - Number(localStorage.getItem(SKIP) || 0) < WEEK || sessionStorage.getItem(SKIP) === '1';
  } catch {}
  if (!getPlayer().name && !skipped) open();
</script>
