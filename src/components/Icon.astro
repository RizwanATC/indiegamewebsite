---
/**
 * Rounded line icons on a 24x24 grid, drawn to match the moulded-plastic
 * look. Decorative by default (aria-hidden); pass `label` when the icon is
 * the only content.
 */
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  label?: string;
  class?: string;
}

const ICONS = {
  play: 'M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z',
  download: 'M12 3.5v11m0 0-4.5-4.5M12 14.5l4.5-4.5M4.5 19.5h15',
  external: 'M13.5 4.5h6v6m0-6-8.5 8.5M10 5.5H6a1.5 1.5 0 0 0-1.5 1.5v11A1.5 1.5 0 0 0 6 19.5h11a1.5 1.5 0 0 0 1.5-1.5v-4',
  search: 'M10.5 17.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm5-2 5 5',
  fullscreen: 'M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5',
  warning: 'M12 4 2.8 19.5h18.4L12 4zm0 6v4.5m0 2.5v.5',
  arrow: 'M4.5 12h15m0 0-6-6m6 6-6 6',
  arrowLeft: 'M19.5 12h-15m0 0 6-6m-6 6 6 6',
  close: 'M6 6l12 12M18 6 6 18',
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z',
  user: 'M12 11.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 20.5c.8-4 3.8-6 7.5-6s6.7 2 7.5 6',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zm0-13.5V12l3 2',
  menu: 'M4 7h16M4 12h16M4 17h16',
} as const;

const FILLED = new Set(['play']);
const { name, size = 16, label, class: className } = Astro.props;
const filled = FILLED.has(name);
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={filled ? 1.5 : 2.4}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  <path d={ICONS[name]}></path>
</svg>
