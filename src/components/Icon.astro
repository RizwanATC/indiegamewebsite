---
/**
 * Small pixel-style icons drawn on a 16x16 grid. Decorative by default
 * (aria-hidden); pass `label` when the icon is the only content.
 */
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  label?: string;
  class?: string;
}

const ICONS = {
  play: 'M4 2h2v1h2v1h2v1h2v1h1v4h-1v1h-2v1H8v1H6v1H4z',
  download: 'M7 1h2v7h2V7h2v2h-1v1h-1v1h-1v1H8v-1H7v-1H6V9H5V8h-2V7h2v1h2zM2 13h12v2H2z',
  external: 'M9 1h6v6h-2V4.5L8 9.5 6.5 8l5-5H9zM1 3h6v2H3v8h8V9h2v6H1z',
  search: 'M6 1h3v1h2v2h1v3h-1v2h-1v1h3v1h1v1h1v2h-2v-1h-1v-1h-1v-1H9v1H6v-1H4V9H3V6h1V4h1V2h1zm0 3v1H5v3h1v1h3V8h1V5H9V4z',
  fullscreen: 'M1 1h5v2H3v3H1zm9 0h5v5h-2V3h-3zM1 10h2v3h3v2H1zm12 0h2v5h-5v-2h3z',
  warning: 'M7 1h2v2h1v3h1v3h1v3h1v3H3v-3h1V9h1V6h1V3h1zm0 5v4h2V6zm0 5v2h2v-2z',
  arrow: 'M9 3h2v1h1v1h1v1h1v1h1v2h-1v1h-1v1h-1v1h-1v1H9v-2h1v-1h1V9H1V7h10V6h-1V5H9z',
  close: 'M2 2h3v1h1v1h1v1h2V4h1V3h1V2h3v3h-1v1h-1v1h-1v2h1v1h1v1h1v3h-3v-1h-1v-1h-1v-1H7v1H6v1H5v1H2v-3h1v-1h1V9h1V7H4V6H3V5H2z',
  globe: 'M6 1h4v1h2v1h1v2h1v6h-1v2h-1v1h-2v1H6v-1H4v-1H3v-2H2V5h1V3h1V2h2zm1 2v3H4v1h3v2H4v1h3v3h2v-3h3V9H9V7h3V6H9V3z',
  user: 'M6 1h4v1h1v4h-1v1H6V6H5V2h1zM3 9h10v1h1v5H2v-5h1z',
  clock: 'M6 1h4v1h2v1h1v2h1v6h-1v2h-1v1h-2v1H6v-1H4v-1H3v-2H2V5h1V3h1V2h2zm1 3v5h4V7H9V4z',
  menu: 'M1 3h14v2H1zm0 4h14v2H1zm0 4h14v2H1z',
} as const;

const { name, size = 16, label, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  <path d={ICONS[name]} fill-rule="evenodd"></path>
</svg>
