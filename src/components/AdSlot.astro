---
/**
 * A clearly labelled Google AdSense display unit. Renders NOTHING unless
 * ADS.enabled is true, the publisher ID is set and this slot has an ad-unit
 * ID in src/config.ts, so the site never shows empty ad boxes.
 *
 * Ad slots always sit between content sections, never inside game
 * descriptions, players or download panels.
 */
import { ADS, ADSENSE_CONNECTED } from '../config';

interface Props {
  /** Key in ADS.slots, e.g. "home-mid" or "game-sidebar". */
  id: string;
  size?: 'banner' | 'rectangle';
}
const { id, size = 'banner' } = Astro.props;
const unitId = ADS.slots[id] ?? '';
const live = ADS.enabled && ADSENSE_CONNECTED && /^\d+$/.test(unitId);
const devPreview = import.meta.env.DEV && ADS.showDevPlaceholders;
---

{
  live ? (
    <aside class:list={['ad', size]} aria-label="Advertisement" data-ad-slot-name={id}>
      <span class="ad-label">Advertisement</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADS.publisherId}
        data-ad-slot={unitId}
        data-ad-format={size === 'rectangle' ? 'rectangle' : 'horizontal'}
        data-full-width-responsive="true"
      />
    </aside>
  ) : (
    devPreview && (
      <aside class:list={['ad', 'preview', size]} aria-hidden="true">
        Ad slot “{id}” (dev preview only)
      </aside>
    )
  )
}

<script>
  // Bundled into an external file, so the strict CSP (no inline scripts) holds.
  type AdQueue = { push: (o: object) => void };
  const w = window as unknown as { adsbygoogle?: AdQueue };
  document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(() => {
    (w.adsbygoogle = w.adsbygoogle || ([] as unknown as AdQueue)).push({});
  });
</script>

<style>
  .ad {
    position: relative;
    display: grid;
    place-items: center;
    margin: 32px auto;
    max-width: 728px;
    min-height: 90px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  .rectangle {
    max-width: 300px;
    min-height: 250px;
  }
  .ad ins {
    width: 100%;
    margin-top: 18px;
  }
  .ad-label {
    position: absolute;
    top: 4px;
    left: 8px;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .preview {
    border-style: dashed;
    color: var(--text-faint);
    font-size: 0.8rem;
  }
</style>
