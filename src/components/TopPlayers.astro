---
/**
 * Compact leaderboard for the home page: one arcade panel with a tab per
 * game and that game's top 5 as slim rows. It sits under today's game so the
 * game stays the first thing people see. Scores load in the browser from
 * /api/scores (same data as Leaderboard.astro), one game at a time.
 */
import Icon from './Icon.astro';
import { LEADERBOARDS } from '../config';

interface Props {
  /** Games with a board, in display order: [{ slug, title, href }]. */
  games: { slug: string; title: string; href: string }[];
  /** The tab that starts open (today's game when it has a board). */
  initial?: string;
}
const { games, initial } = Astro.props;
const list = games.filter((g) => LEADERBOARDS[g.slug]);
const first = list.find((g) => g.slug === initial)?.slug ?? list[0]?.slug;
---

{
  list.length > 0 && (
    <section class="section top" aria-labelledby="top-heading">
      <div class="container">
        <div class="panel" data-top data-first={first}>
          <div class="head">
            <div>
              <p class="kicker" aria-hidden="true">
                <span class="star">★</span> High scores <span class="star">★</span>
              </p>
              <h2 id="top-heading">Top players</h2>
            </div>
            <a class="btn btn-sm btn-ghost" href="/leaderboard/">
              Full leaderboard <Icon name="arrow" />
            </a>
          </div>
          <div class="tabs" role="tablist" aria-label="Pick a game">
            {list.map((g) => (
              <button
                type="button"
                role="tab"
                class="tab"
                id={`top-tab-${g.slug}`}
                aria-controls="top-list"
                aria-selected={g.slug === first ? 'true' : 'false'}
                data-tab={g.slug}
                data-href={g.href}
              >
                {g.title}
              </button>
            ))}
          </div>
          <div id="top-list" role="tabpanel" aria-labelledby={`top-tab-${first}`} data-panel>
            <p class="status" data-status role="status">
              Loading scores…
            </p>
            <ol class="rows" data-rows hidden />
            <p class="foot">
              <span class="me" data-me />
              <a class="play" data-play href={list.find((g) => g.slug === first)?.href}>
                Play and beat them <Icon name="arrow" />
              </a>
            </p>
          </div>
          <template data-row>
            <li>
              <span class="rank" />
              <span class="name" />
              <span class="score" />
            </li>
          </template>
        </div>
      </div>
    </section>
  )
}

<style>
  .section.top {
    padding-top: 24px;
    padding-bottom: 8px;
  }
  .panel {
    --gold: #f7c948;
    --silver: #d6d3e8;
    --bronze: #e3a06b;
    --pink: #f472b6;
    position: relative;
    display: grid;
    gap: 14px;
    padding: 18px;
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 60% at 50% 0%, rgb(167 139 250 / 0.18), transparent 60%) padding-box,
      linear-gradient(180deg, #1b1538, #0f0c20) padding-box,
      linear-gradient(135deg, var(--accent), var(--pink) 45%, var(--gold)) border-box;
    box-shadow: 6px 6px 0 0 #2e1065;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 10px;
  }
  .head h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .kicker {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .star {
    color: var(--pink);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tab {
    flex: none;
    padding: 7px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab[aria-selected='true'] {
    border-color: var(--gold);
    background: var(--gold);
    color: #1b1538;
  }

  .status {
    margin: 0;
    padding: 18px 0;
    color: var(--text-muted);
    text-align: center;
  }
  .rows {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .rows {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
  .rows :global(li) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 8px 12px;
    border: 1px solid rgb(167 139 250 / 0.25);
    border-radius: var(--radius);
    background: rgb(15 12 32 / 0.6);
  }
  .rows :global(li.is-you) {
    border-color: var(--accent-strong);
    background: rgb(167 139 250 / 0.16);
  }
  .rows :global(.rank) {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #2a2350;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.6rem;
  }
  .rows :global(li:nth-child(1) .rank) {
    background: var(--gold);
    color: #1b1538;
  }
  .rows :global(li:nth-child(2) .rank) {
    background: var(--silver);
    color: #1b1538;
  }
  .rows :global(li:nth-child(3) .rank) {
    background: var(--bronze);
    color: #1b1538;
  }
  .rows :global(.name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }
  .rows :global(.score) {
    font-family: var(--font-display);
    font-size: 0.65rem;
    color: var(--accent-strong);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 4px 0 0;
    font-size: 0.85rem;
  }
  .me {
    color: var(--text-muted);
  }
  .play {
    margin-left: auto;
    font-weight: 600;
    color: var(--gold);
  }
</style>

<script>
  import { getPlayer, PLAYER_EVENT } from '../lib/player';

  interface Row {
    rank: number;
    name: string;
    score: number;
    you: boolean;
  }
  interface Data {
    total: number;
    top: Row[];
    me: { rank: number; score: number } | null;
  }

  const fmt = new Intl.NumberFormat('en');
  const LIMIT = 5;

  document.querySelectorAll<HTMLElement>('[data-top]').forEach((el) => {
    const tabs = [...el.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panel = el.querySelector<HTMLElement>('[data-panel]')!;
    const status = el.querySelector<HTMLElement>('[data-status]')!;
    const rows = el.querySelector<HTMLOListElement>('[data-rows]')!;
    const me = el.querySelector<HTMLElement>('[data-me]')!;
    const play = el.querySelector<HTMLAnchorElement>('[data-play]')!;
    const tpl = el.querySelector<HTMLTemplateElement>('[data-row]')!;
    const cache = new Map<string, Data>();
    let game = el.dataset.first!;

    function render(data: Data) {
      const top = data.top.slice(0, LIMIT);
      rows.replaceChildren(
        ...top.map((r) => {
          const li = (tpl.content.firstElementChild as HTMLLIElement).cloneNode(true) as HTMLLIElement;
          li.querySelector('.rank')!.textContent = String(r.rank);
          li.querySelector('.name')!.textContent = r.name;
          li.querySelector('.score')!.textContent = fmt.format(r.score);
          if (r.you) li.classList.add('is-you');
          return li;
        }),
      );
      rows.hidden = top.length === 0;
      status.hidden = top.length > 0;
      status.textContent = 'No scores yet. Play a round and be the first!';
      const inTop = top.some((r) => r.you);
      me.textContent = data.me && !inTop ? `You: #${data.me.rank} of ${fmt.format(data.total)}` : '';
    }

    async function load(slug: string, fresh = false) {
      if (!fresh && cache.has(slug)) return render(cache.get(slug)!);
      if (!cache.has(slug)) {
        rows.hidden = true;
        status.hidden = false;
        status.textContent = 'Loading scores…';
        me.textContent = '';
      }
      try {
        const res = await fetch(`/api/scores?game=${encodeURIComponent(slug)}&player=${encodeURIComponent(getPlayer().id)}`, { cache: 'no-store' });
        if (res.status === 503) throw new Error('soon');
        if (!res.ok) throw new Error('down');
        const data = (await res.json()) as Data;
        cache.set(slug, data);
        if (slug === game) render(data);
      } catch (err) {
        if (slug !== game) return;
        rows.hidden = true;
        status.hidden = false;
        status.textContent = (err as Error).message === 'soon' ? 'The leaderboard is coming soon.' : 'Scores could not be loaded right now.';
      }
    }

    function select(tab: HTMLButtonElement, focus = false) {
      game = tab.dataset.tab!;
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      }
      panel.setAttribute('aria-labelledby', tab.id);
      play.href = tab.dataset.href!;
      if (focus) tab.focus();
      load(game);
    }

    tabs.forEach((tab, i) => {
      tab.tabIndex = tab.dataset.tab === game ? 0 : -1;
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(tabs[(i + d + tabs.length) % tabs.length], true);
      });
    });

    load(game);
    window.addEventListener(PLAYER_EVENT, () => {
      cache.clear();
      setTimeout(() => load(game, true), 400);
    });
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      cache.clear();
      load(game, true);
    });
  });
</script>
