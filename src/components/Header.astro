---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Today', match: (p: string) => p === '/' },
  { href: '/games/', label: 'All games', match: (p: string) => p.startsWith('/games') || p.startsWith('/genres') },
  { href: '/about/', label: 'About', match: (p: string) => p.startsWith('/about') },
];
---

<header class="site-header">
  <div class="container bar">
    <Logo />
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <form class="header-search" action="/games/" method="get" role="search">
      <label for="header-q" class="visually-hidden">Search games</label>
      <Icon name="search" class="search-icon" />
      <input id="header-q" class="input" type="search" name="q" placeholder="Search games" autocomplete="off" />
    </form>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px 24px;
    min-height: 68px;
    flex-wrap: wrap;
    padding-block: 10px;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--ground);
  }
  nav a[aria-current='page'] {
    background: var(--sun);
    color: var(--ink);
  }
  .header-search {
    position: relative;
    display: none;
    width: 230px;
  }
  .header-search .input {
    min-height: 42px;
    padding: 6px 14px 6px 40px;
    font-size: 0.92rem;
  }
  .header-search :global(.search-icon) {
    position: absolute;
    left: 15px;
    top: 50%;
    translate: 0 -50%;
    color: var(--ink-faint);
    pointer-events: none;
  }
  @media (min-width: 860px) {
    .header-search {
      display: block;
    }
  }
  @media (max-width: 420px) {
    .bar {
      gap: 8px;
    }
    nav a {
      padding: 0 10px;
      font-size: 0.9rem;
    }
  }
</style>
