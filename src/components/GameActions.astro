---
/**
 * Primary call-to-action buttons for a game.
 *
 * - "Play Now" only appears when the game has a playUrl. Embeddable games
 *   jump to the on-page player; everything else opens the official page in a
 *   new tab.
 * - The download button only appears when downloadUrl is set. On cards and
 *   the home hero it links to the game page's download section first, so the
 *   player always sees where the file comes from and the safety note.
 */
import Icon from './Icon.astro';
import { gameUrl, hostname, isExternal, playMode, type Game } from '../lib/games';

interface Props {
  game: Game;
  context: 'hero' | 'detail';
}
const { game, context } = Astro.props;
const d = game.data;
const play = playMode(game);
const detail = gameUrl(game);

const downloadLabel = d.downloadType === 'apk' ? 'Download APK' : d.downloadType === 'store' ? 'Get it on the store' : 'Official download';
---

<div class="actions">
  {
    play.kind === 'embed' && (
      <a class:list={['btn btn-primary', { knob: context === 'hero' }]} href={context === 'hero' ? `${detail}#play` : '#play'} data-play-trigger={context === 'detail' ? '' : undefined}>
        {context === 'hero' ? <span class="knob-face"><Icon name="knob" size={26} /></span> : <Icon name="play" />} Play Now
      </a>
    )
  }
  {
    play.kind === 'external' && (
      <a class="btn btn-primary" href={play.url} target="_blank" rel="noopener">
        <Icon name="play" /> Play Now
        <span class="host">{isExternal(play.url) ? `on ${hostname(play.url)}` : ''}</span>
        <Icon name="external" size={12} />
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    )
  }
  {
    d.downloadUrl && (
      <a class="btn" href={context === 'hero' ? `${detail}#download` : '#download'}>
        <Icon name="download" /> {downloadLabel}
      </a>
    )
  }
  {
    context === 'hero' && (
      <a class="btn btn-ghost" href={detail}>
        Game details <Icon name="arrow" />
      </a>
    )
  }
</div>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .host {
    font-weight: 500;
    opacity: 0.8;
  }
  /* The big turning knob of the machine. */
  .knob {
    min-height: 60px;
    padding: 8px 28px 8px 8px;
    font-size: 1.15rem;
  }
  .knob-face {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    box-shadow:
      0 2px 4px -2px rgb(255 255 255 / 0.6) inset,
      0 -3px 6px -3px rgb(0 0 0 / 0.15) inset;
    animation: turn 0.9s 0.2s var(--ease) both;
    transition: rotate 0.5s var(--ease);
  }
  .knob:hover .knob-face,
  .knob:focus-visible .knob-face {
    rotate: 90deg;
  }
  @keyframes turn {
    from {
      rotate: -180deg;
    }
  }
  @media (max-width: 479px) {
    .actions > :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
