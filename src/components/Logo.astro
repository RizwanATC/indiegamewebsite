---
import { SITE } from '../config';
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---

<a href="/" class:list={['logo', `logo-${size}`]} aria-label={`${SITE.name} home`}>
  <span class="logo-word" aria-hidden="true">INDIE<span class="slash">/</span>24</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px 6px;
    border-radius: var(--radius-pill);
    background: var(--red);
    box-shadow:
      0 2px 4px -2px rgb(255 255 255 / 0.35) inset,
      0 -3px 6px -3px rgb(0 0 0 / 0.18) inset;
    color: #fff;
    text-decoration: none;
  }
  .logo:hover {
    color: #fff;
  }
  .logo-word {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .logo-lg {
    padding: 10px 20px 9px;
  }
  .logo-lg .logo-word {
    font-size: clamp(1.4rem, 5vw, 2rem);
  }
  .slash {
    display: inline-block;
    color: var(--sun);
    transition: transform 0.3s var(--ease);
  }
  .logo:hover .slash {
    transform: rotate(-14deg);
  }
</style>
