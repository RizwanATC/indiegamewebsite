---
import { Image } from 'astro:assets';
import GameLabels from './GameLabels.astro';
import Icon from './Icon.astro';
import { capColor, formatDate, gameUrl, genreLabel, platformLabel, type Game } from '../lib/games';

interface Props {
  game: Game;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { game, headingLevel: H = 'h3', eager = false } = Astro.props;
const d = game.data;
const playable = Boolean(d.playUrl);
---

<article
  class="card"
  data-game-card
  data-title={d.title.toLowerCase()}
  data-genres={d.genres.join(' ')}
  data-platforms={d.platforms.join(' ')}
  data-date={d.featuredDate}
  data-cap={capColor(d.genres[0] ?? d.title)}
>
  <div class="media">
    <Image
      src={d.coverImage}
      alt={d.coverAlt}
      widths={[400, 640, 800]}
      sizes="(min-width: 1200px) 380px, (min-width: 640px) 45vw, 100vw"
      class="pixelated"
      loading={eager ? 'eager' : 'lazy'}
    />
    <div class="overlay">
      {playable && (
        <span class="badge badge-accent">
          <Icon name="play" size={12} /> Play in browser
        </span>
      )}
      <GameLabels game={game} />
    </div>
  </div>
  <div class="body">
    <p class="date"><time datetime={d.featuredDate}>{formatDate(d.featuredDate)}</time></p>
    <H class="title"><a href={gameUrl(game)} class="stretched">{d.title}</a></H>
    <p class="desc">{d.shortDescription}</p>
    <ul class="badge-list meta" aria-label="Genres and platforms">
      {d.genres.map((g) => <li class="badge">{genreLabel(g)}</li>)}
      {d.platforms.map((p) => <li class="badge platform">{platformLabel(p)}</li>)}
    </ul>
  </div>
</article>

<style>
  /* Each past pick is a capsule: a coloured dome holding the art, a white base holding the label. */
  .card {
    --cap: var(--sky);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 2px solid var(--ink);
    border-radius: 140px 140px 26px 26px / 96px 96px 26px 26px;
    background: var(--paper);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .card[data-cap='sun'] { --cap: var(--sun); }
  .card[data-cap='sky'] { --cap: var(--sky); }
  .card[data-cap='mint'] { --cap: var(--mint); }
  .card[data-cap='gum'] { --cap: var(--gum); }
  .card[data-cap='grape'] { --cap: var(--grape); }
  .card[data-cap='red'] { --cap: #ff8a5c; }
  .card:hover,
  .card:focus-within {
    transform: translateY(-5px) rotate(-0.6deg);
    box-shadow: var(--shadow-lift);
  }
  .media {
    position: relative;
    padding: 12px 12px 0;
    background:
      radial-gradient(60% 40% at 30% 12%, rgb(255 255 255 / 0.55), transparent 70%),
      var(--cap);
    border-bottom: 2px solid var(--ink);
  }
  .media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 120px 120px 0 0 / 80px 80px 0 0;
    transition: scale 0.5s var(--ease);
  }
  .card:hover .media :global(img) {
    scale: 1.03;
  }
  .overlay {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .overlay :global(.badge) {
    box-shadow: 0 4px 10px -6px rgb(0 0 0 / 0.6);
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 20px 20px;
  }
  .date {
    margin: 0 0 4px;
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .title {
    font-size: 1.2rem;
    margin: 0 0 8px;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Whole card is clickable, but only the title is the link in the a11y tree. */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .card:has(.stretched:focus-visible) {
    outline: 3px solid var(--sky);
    outline-offset: 4px;
  }
  .desc {
    margin: 0 0 14px;
    font-size: 0.95rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin-top: auto;
  }
  .platform {
    border-style: dashed;
  }
</style>
