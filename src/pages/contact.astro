---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config';
const mail = (subject: string) => `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(subject)}`;
---

<PageLayout title="Contact" eyebrow="Say hello" description={`How to get in touch with ${SITE.name}: game suggestions, developer submissions and general questions.`}>
  <p>
    The simplest way to reach us is email: <a href={`mailto:${SITE.contactEmail}`}><strong>{SITE.contactEmail}</strong></a>. It's a small project run by
    one person, so replies can take a few days.
  </p>

  <div class="options">
    <a class="panel option" href={mail('Game suggestion')}>
      <h2>Suggest a game</h2>
      <p class="muted">Found something great? Send the title and a link to its official page.</p>
    </a>
    <a class="panel option" href={mail('Developer submission')}>
      <h2>Submit your game</h2>
      <p class="muted">Include a link to your game, whether it can be embedded in a browser, and where players can download it.</p>
    </a>
    <a class="panel option" href={mail('General question')}>
      <h2>Anything else</h2>
      <p class="muted">Questions, feedback or partnership ideas.</p>
    </a>
  </div>

  <h2>Common questions</h2>
  <h3>Are the games really free?</h3>
  <p>
    Yes. Every game plays free in your browser with no account, and the Android apps are free too, with no ads and no in-app purchases. The website
    shows a few ads around the pages to cover hosting, never inside a game.
  </p>
  <h3>My progress disappeared. Can you restore it?</h3>
  <p>
    Unfortunately not. Progress is saved only on your own device, so clearing your browser's site data or uninstalling an app removes it. We never
    see it. Leaderboard scores are the exception: they stay on the <a href="/leaderboard/">leaderboard</a>.
  </p>
  <h3>Can I have my leaderboard name or score removed?</h3>
  <p>Yes. Email us the name and the game, and we'll remove it.</p>
  <h3>I'm stuck on a level.</h3>
  <p>
    Have a look at <a href="/blog/">Guides &amp; Devlog</a>. There's a strategy guide or walkthrough for every game. If you think you've found a level
    that can't be finished, tell us which one and what happens.
  </p>
  <h3>Will you feature my game?</h3>
  <p>
    Right now {SITE.name} only publishes games we make ourselves, but we're always happy to play other small games. Send us a link and you might
    see it here one day.
  </p>

  <h2>Reporting a problem?</h2>
  <p>
    For broken links, copyright concerns or anything unsafe, please use the <a href="/report/">Report a Game</a> page so it reaches the right inbox
    quickly.
  </p>
</PageLayout>

<style>
  .options {
    display: grid;
    gap: 12px;
    margin: 28px 0;
  }
  .option {
    display: block;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.2s var(--ease);
  }
  .option:hover {
    color: var(--text);
    border-color: var(--accent);
    transform: translateX(4px);
  }
  .option h2 {
    margin: 0 0 4px;
    font-size: 1.05rem;
  }
  .option p {
    margin: 0;
  }
</style>
