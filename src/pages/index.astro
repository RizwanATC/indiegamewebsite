---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedGame from '../components/FeaturedGame.astro';
import GameCard from '../components/GameCard.astro';
import GenreNav from '../components/GenreNav.astro';
import SearchForm from '../components/SearchForm.astro';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import BoardTabs from '../components/BoardTabs.astro';
import PostList from '../components/PostList.astro';
import { LEADERBOARDS, SITE } from '../config';
import { allGenres, allPlatforms, gameSlug, gameUrl, getVisibleGames, getVisiblePosts, pickDailyGame, platformLabel } from '../lib/games';

const games = await getVisibleGames();
const pick = pickDailyGame(games);
const recent = games.filter((g) => g.id !== pick?.game.id).slice(0, SITE.recentCount);
const boards = games.filter((g) => LEADERBOARDS[gameSlug(g)]);
const genres = allGenres(games);
const posts = (await getVisiblePosts()).slice(0, 3);
const platforms = allPlatforms(games);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL('/', Astro.site).href,
  description: SITE.description,
};
---

<BaseLayout jsonLd={jsonLd}>
  <FeaturedGame pick={pick}>
    {
      boards.length > 0 && (
        <BoardTabs
          slot="aside"
          games={boards.map((g) => ({ slug: gameSlug(g), title: g.data.title, href: gameUrl(g), cover: g.data.coverImage }))}
          initial={pick ? gameSlug(pick.game) : undefined}
        />
      )
    }
  </FeaturedGame>

  <section class="section browse" aria-labelledby="browse-heading">
    <div class="container">
      <div class="browse-grid">
        <div>
          <p class="eyebrow">Browse games</p>
          <h2 id="browse-heading">Find your next favourite</h2>
          <p class="muted">Every game we've ever featured, searchable by title and sortable by genre and platform.</p>
          <SearchForm id="home-q" />
        </div>
        <div class="filters">
          <h3 class="label">By genre</h3>
          <GenreNav genres={genres} />
          <h3 class="label">By platform</h3>
          <ul class="platforms">
            {
              platforms.map((p) => (
                <li>
                  <a class="chip" href={`/games/?platform=${p}`}>
                    {platformLabel(p)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="container"><AdSlot id="home-mid" /></div>

  <section class="section recent" aria-labelledby="recent-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Previously featured</p>
          <h2 id="recent-heading">Recent picks</h2>
        </div>
        <a class="btn btn-sm btn-ghost" href="/games/">View all games <Icon name="arrow" /></a>
      </div>
      {
        recent.length > 0 ? (
          <ul class="game-grid">
            {recent.map((game) => (
              <li>
                <GameCard game={game} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">Past picks will appear here once a few days have gone by.</p>
        )
      }
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section posts" aria-labelledby="posts-heading">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Read</p>
              <h2 id="posts-heading">Guides &amp; devlog</h2>
            </div>
            <a class="btn btn-sm btn-ghost" href="/blog/">All posts <Icon name="arrow" /></a>
          </div>
          <PostList posts={posts} />
        </div>
      </section>
    )
  }

  <section class="section studio" aria-labelledby="studio-heading">
    <div class="container">
      <div class="studio-text">
        <p class="eyebrow">Who we are</p>
        <h2 id="studio-heading">Small games, made here</h2>
        <p>
          {SITE.name} is a tiny independent game studio. Every game on this site is designed and coded by us, with its own chiptune music, and you can play all of
          them free in your browser, on a computer or a phone, with no account and no download. Each one also has a free Android app with no ads.
        </p>
        <p>
          Alongside the games we write <a href="/blog/">strategy guides and devlogs</a>: how to beat each game, and how each one was made. Read more{' '}
          <a href="/about/">about us</a>, or <a href="/contact/">get in touch</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .posts,
  .studio {
    border-top: 1px solid var(--border);
  }
  .studio-text {
    max-width: 68ch;
  }
  .studio-text p {
    color: var(--text-muted);
  }
  .browse {
    border-bottom: 1px solid var(--border);
  }
  .browse-grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .browse-grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
  }
  .filters {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .filters .label {
    margin: 8px 0 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
