---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config';
import { POST_KIND_LABELS, formatDate, gameSlug, gameUrl, getVisibleGames, getVisiblePosts, postUrl, readingMinutes, type Post } from '../../lib/games';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}
const { post, posts } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const games = await getVisibleGames();
const game = d.game ? games.find((g) => gameSlug(g) === d.game) : undefined;
if (d.game && !game) {
  // A post about a game that isn't visible yet would link to a missing page.
  const all = await getCollection('games');
  if (!all.some((g) => gameSlug(g) === d.game)) throw new Error(`Post "${post.id}" names unknown game "${d.game}"`);
}
// Same game first, then the newest of the rest.
const more = [...posts.filter((p) => p.id !== post.id && d.game && p.data.game === d.game), ...posts.filter((p) => p.id !== post.id && !(d.game && p.data.game === d.game))].slice(0, 4);
const minutes = readingMinutes(post.body);
const url = new URL(postUrl(post), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date,
  dateModified: d.updated ?? d.date,
  author: { '@type': 'Organization', name: d.author, url: new URL('/about/', Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
  mainEntityOfPage: url,
  ...(game ? { about: { '@type': 'VideoGame', name: game.data.title, url: new URL(gameUrl(game), Astro.site).href } } : {}),
};
---

<BaseLayout title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <article class="section">
    <div class="container narrow">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/blog/">Guides &amp; Devlog</a> <span aria-hidden="true">/</span> <span>{POST_KIND_LABELS[d.kind]}</span>
      </nav>
      <h1>{d.title}</h1>
      <p class="byline muted">
        By {d.author} · <time datetime={d.date}>{formatDate(d.date, 'long')}</time>
        {d.updated && <> · Updated <time datetime={d.updated}>{formatDate(d.updated, 'long')}</time></>} · {minutes} min read
      </p>
      {
        game && (
          <a class="game-strip" href={gameUrl(game)}>
            <Image src={game.data.coverImage} alt="" widths={[240, 480]} sizes="160px" class="pixelated" />
            <span>
              <span class="label">About the game</span>
              <strong>{game.data.title}</strong>
              <span class="muted">{game.data.shortDescription}</span>
              <span class="go">
                {game.data.playUrl ? 'Play it free in your browser' : 'View the game'} <Icon name="arrow" />
              </span>
            </span>
          </a>
        )
      }
      <div class="prose"><Content /></div>
    </div>
  </article>
  {
    more.length > 0 && (
      <section class="section more" aria-labelledby="more-heading">
        <div class="container">
          <h2 id="more-heading">Keep reading</h2>
          <PostList posts={more} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }
  .crumbs {
    margin-bottom: 20px;
    font-size: 0.875rem;
    color: var(--text-faint);
  }
  .crumbs span[aria-hidden] {
    margin-inline: 6px;
    color: var(--accent);
  }
  h1 {
    line-height: 1.3;
  }
  .byline {
    margin: 8px 0 24px;
    font-size: 0.9rem;
  }
  .game-strip {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    align-items: center;
    margin: 0 0 32px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: var(--text);
    text-decoration: none;
  }
  .game-strip:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .game-strip :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .game-strip > span {
    display: grid;
    gap: 4px;
    font-size: 0.9rem;
  }
  .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }
  .go {
    color: var(--accent-strong);
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .game-strip {
      grid-template-columns: 1fr;
    }
  }
  .more {
    border-top: 1px solid var(--border);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0 1.5em;
    font-size: 0.925rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--text);
  }
</style>
