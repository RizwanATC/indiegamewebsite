---
/**
 * PRIVACY POLICY TEMPLATE
 * This page describes what the site does TODAY. The advertising parts switch
 * on by themselves when ADS.publisherId is set in src/config.ts. If you add
 * anything else (analytics, accounts), update this page before you ship it.
 * This template is not legal advice.
 */
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, ADSENSE_CONNECTED as ads } from '../config';
const lastUpdated = ads ? '29 October 2026' : '27 October 2026';
---

<PageLayout title="Privacy Policy" eyebrow="Plain language" description={ads ? `How ${SITE.name} handles your data, including the Google ads we show.` : `How ${SITE.name} handles your data: no accounts, no analytics, no advertising cookies.`}>
  <p class="muted">Last updated: {lastUpdated}</p>

  {
    ads ? (
      <p>
        This policy explains what happens to your information when you visit {SITE.name}. The short version: we show ads from Google to keep the
        site free, Google uses cookies to do that, and we don't run our own analytics or have user accounts.
      </p>
    ) : (
      <p>
        This policy explains what happens to your information when you visit {SITE.name}. The short version: we don't run analytics, we don't set
        cookies, we don't show ads, and there are no user accounts.
      </p>
    )
  }

  <h2>Information we don't collect</h2>
  <ul>
    <li>We don't use our own analytics or tracking scripts.</li>
    {ads ? <li>We don't set cookies ourselves. Our advertising partner does; see below.</li> : <li>We don't set cookies.</li>}
    {!ads && <li>We don't show advertising and don't share data with ad networks.</li>}
    <li>There are no accounts, sign-ups or comment forms.</li>
  </ul>

  {
    ads && (
      <>
        <h2>Advertising</h2>
        <p>
          We show ads served by Google AdSense in clearly labelled boxes on some pages. Ads never appear inside games. Google and its partners use
          cookies and similar technologies to serve ads based on your visits to this and other websites, to limit how often you see an ad and to
          measure ad performance. Google's use of advertising cookies lets it and its partners serve ads to you based on your visits to
          {SITE.name} and/or other sites on the Internet.
        </p>
        <ul>
          <li>
            You can turn off personalised ads in <a href="https://adssettings.google.com/" rel="noopener">Google's Ad Settings</a>, or opt out of
            many third-party vendors at <a href="https://www.aboutads.info/choices/" rel="noopener">aboutads.info</a>.
          </li>
          <li>
            If you visit from the European Economic Area, the UK or Switzerland, we ask for your consent before personalised ads are shown, and you
            can change your choice at any time through the privacy settings link on the page.
          </li>
          <li>
            Learn more in <a href="https://policies.google.com/technologies/partner-sites" rel="noopener">How Google uses information from sites
            that use its services</a>.
          </li>
        </ul>
      </>
    )
  }

  <h2>Hosting</h2>
  <p>
    The site is a set of static files served by Vercel. Like any web host, Vercel processes technical data such as your IP address and browser
    details to deliver pages and protect the service from abuse. See
    <a href="https://vercel.com/legal/privacy-policy" rel="noopener">Vercel's privacy policy</a> for details. Fonts and images are served from
    our own site, not from third-party font services.
  </p>

  <h2>Playing games</h2>
  <p>
    Embedded games only load after you press <strong>Play Now</strong>. Games hosted on {SITE.name} may save things like your high score in your
    browser's local storage; that data stays on your device and you can clear it in your browser settings. When a game is hosted by another website,
    pressing Play loads it from that website, and that site's own privacy policy applies.
  </p>

  <h2>Links to other sites</h2>
  <p>
    Game pages link to developers' websites, stores and download pages. We don't control those sites. Their privacy policies apply once you leave
    {SITE.name}.
  </p>

  <h2>Emailing us</h2>
  <p>
    If you email us (for example through the contact or report pages), we receive your email address and whatever you write. We use it only to
    reply and to handle your request, and we don't add you to any mailing list.
  </p>

  <h2>Children</h2>
  <p>{SITE.name} doesn't knowingly collect personal information from anyone, including children.</p>

  <h2>Changes</h2>
  <p>
    If we ever add analytics{ads ? '' : ', advertising'} or anything else that affects your privacy, we'll update this page first and change the
    date at the top.
  </p>

  <h2>Contact</h2>
  <p>Questions about privacy: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
</PageLayout>
